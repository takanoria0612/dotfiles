#!/usr/bin/env bash

# --- Tokyo Night Color Palette ---
BAR_COLOR=0xff414868        # Barの背景: Tokyo Night Storm
LABEL_COLOR=0xffc0caf5      # 文字色
ITEM_BG_COLOR=0xff414868    # アイテム背景
FONT="Hack Nerd Font"

# --- バー設定 ---
sketchybar --bar \
    height=29 \
    color=$BAR_COLOR \
    position=top \
    sticky=on \
    padding_left=10 \
    padding_right=10 \
    corner_radius=5 \
    y_offset=5 \
    blur_radius=20 \
    shadow=on

# --- デフォルト設定 ---
sketchybar --default \
    icon.font="$FONT:Bold:16.0" \
    icon.color=$LABEL_COLOR \
    label.font="$FONT:Bold:14.0" \
    label.color=$LABEL_COLOR \
    padding_left=5 \
    padding_right=5 \
    label.padding_left=4 \
    label.padding_right=4 \
    background.corner_radius=5 \
    background.height=21

# --- イベント登録 ---
sketchybar --add event aerospace_workspace_change
sketchybar --add event volume_change

# --- ワークスペース (左側) ---
for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space."$sid" left \
        --subscribe space."$sid" aerospace_workspace_change \
        --set space."$sid" \
            background.color=$ITEM_BG_COLOR \
            background.drawing=off \
            label.drawing=off \
            icon.drawing=on \
            click_script="aerospace workspace $sid" \
            script="$HOME/.config/sketchybar/plugins/aerospace.sh $sid"
done

# --- 右側エリア (右端から順に配置されます) ---

# 1. 時計 (一番右)
sketchybar --add item clock right \
    --set clock \
        update_freq=10 \
        icon="" \
        script="$HOME/.config/sketchybar/plugins/clock.sh" \
        background.color=$ITEM_BG_COLOR \
        background.drawing=on \
        background.padding_left=10

# 2. ボリューム (時計の左隣)
sketchybar --add item volume right \
    --set volume \
        script="$HOME/.config/sketchybar/plugins/volume.sh" \
        update_freq=5 \
        background.color=$ITEM_BG_COLOR \
        background.drawing=on \
        label.drawing=on \
        icon.width=24 \
        click_script="open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'" \
    --subscribe volume volume_change

# --- 初期化 ---
sketchybar --update
echo "SketchyBar config loaded."

